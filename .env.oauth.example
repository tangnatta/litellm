# Replace every change-me value before deploying.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-to-a-random-stable-value
# Use a long URL-safe value because this is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-random-alphanumeric-database-password

# Browser-visible URL used to construct the Antigravity OAuth callback.
LITELLM_PUBLIC_URL=http://localhost:4000
LITELLM_PORT=4000

# Public desktop OAuth application credentials used by Antigravity.
ANTIGRAVITY_OAUTH_CLIENT_ID=change-me
ANTIGRAVITY_OAUTH_CLIENT_SECRET=change-me
